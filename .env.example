# Copiez ce fichier en .env et remplacez les valeurs de démonstration.
HOST=127.0.0.1
PORT=8080
DB_DSN=groupie:REPLACE_WITH_YOUR_LOCAL_PASSWORD@tcp(127.0.0.1:3306)/groupie_tracker?parseTime=true&charset=utf8mb4
# Facultatif : générer ses propres fichiers avec go run ./cmd/devcert
TLS_CERT_FILE=
TLS_KEY_FILE=
# Facultatif : comptes de test PayPal uniquement.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Module Stripe présent dans les sources, non utilisé par le parcours actuel.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

